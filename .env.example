# DX-FSM Environment Variables
# Copy to .env and customize
# DO NOT COMMIT .env — only commit .env.example

# PostgreSQL
POSTGRES_PASSWORD=changeme_postgres_123

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_123

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_123

# Keycloak confidential client (dx-fsm-api)
# Generate with: openssl rand -hex 32
# JWT verify dùng public key từ JWKS nên secret này chỉ cần cho
# service-to-service call. Xem Keycloak admin → Clients → dx-fsm-api → Credentials
# để xem secret hiện tại.

# Ollama (optional)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
